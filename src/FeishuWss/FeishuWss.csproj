<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FeishuWss</RootNamespace>
    <AssemblyName>FeishuWss</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- ==================== NuGet 包元数据 ==================== -->
  <PropertyGroup>
    <PackageId>FeishuWss</PackageId>
    <Version>1.0.0</Version>
    <Authors>FeishuWss contributors</Authors>
    <Company>FeishuWss</Company>
    <Product>FeishuWss</Product>
    <Description>飞书开放平台长连接（WebSocket）SDK 的 C# 实现。HTTP 拉取 endpoint → WebSocket 持久连接 → protobuf 二进制帧收发 → Ping/Pong 保活 → 断线自动重连。无需暴露公网回调地址，进程内即可接收飞书事件与卡片回调。</Description>
    <PackageTags>feishu;lark;websocket;wss;long-connection;longconnection;event;callback;openapi;oapi;sdk</PackageTags>
    <PackageReleaseNotes>首个版本：长连接客户端、事件分发器、protobuf 帧编解码、自动重连、拆包合包。</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package.png</PackageIcon>
    <PackageProjectUrl>https://github.com/whuanle/maomi.feishu</PackageProjectUrl>
    <RepositoryUrl>https://github.com/whuanle/maomi.feishu.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 FeishuWss contributors</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!-- ==================== 打包控制 ==================== -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FeishuWss.Tests" />
  </ItemGroup>

  <!-- ==================== 包内附加文件 ==================== -->
  <!-- README / 图标从仓库根目录引入，避免重复维护 -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\package.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
